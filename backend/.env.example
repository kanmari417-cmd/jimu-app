PORT=4000

# Neon Postgres の接続文字列(Vercel Marketplace経由でプロジェクトに接続すると
# DATABASE_URL として自動的に環境変数へ注入されます。旧 POSTGRES_URL も
# フォールバックとして読み込まれます)。
# ローカル開発では `vercel env pull backend/.env` で取得するか、
# 下記のように手動で設定してください。
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Claude API キー(console.anthropic.com で発行)。
# ⑤経費精算の領収書自動読み取り機能で使用します(未設定でも他の機能は動作します)。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

